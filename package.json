{
  "name": "dsh-plugin-default-auto-review",
  "version": "0.2.0",
  "description": "Start every genuinely new DSH session in a chosen permission mode, and choose that mode from the Harness UI.",
  "type": "module",
  "main": "index.js",
  "author": "DJH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daimajiucai/default-auto-review.git"
  },
  "homepage": "https://github.com/daimajiucai/default-auto-review#readme",
  "bugs": {
    "url": "https://github.com/daimajiucai/default-auto-review/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node ./test/run-all.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "permission",
    "auto-review",
    "session",
    "preset",
    "default-mode"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  }
}
